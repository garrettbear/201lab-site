---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — 201 Lab" description="That page does not exist." path="/404">
  <section class="section" style="text-align:center">
    <div class="shell">
      <p class="eyebrow" style="justify-content:center">Error 404</p>
      <h1>Nothing here.</h1>
      <p class="lede" style="margin-inline:auto">
        That page does not exist, or it moved.
      </p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href="/">Back to 201 Lab</a>
      </div>
    </div>
  </section>
</Base>
